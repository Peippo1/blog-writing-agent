# AI generation (keep secrets server-side; never use VITE_ for a secret)
GOOGLE_API_KEY=
MODEL=gemini-flash-latest

# Authentication. Production requires both Firebase credentials and an allowlist.
FIREBASE_PROJECT_ID=
ALLOWED_EMAILS=you@example.com
APP_ENV=development
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_ALLOWED_ORIGINS=http://localhost:5173
# Local-only convenience; must remain false in deployed environments.
DEV_BYPASS_AUTH=false

# Portfolio integration
PORTFOLIO_REPOSITORY=owner/repository
PORTFOLIO_DEFAULT_BRANCH=main
PORTFOLIO_CONTENT_PATH=content/writing
PORTFOLIO_CONTENT_FORMAT=markdown-frontmatter
PORTFOLIO_SITE_URL=https://tfinch.dev
PORTFOLIO_ARTICLE_URL_PATTERN=/writing/{slug}
GITHUB_WEBHOOK_SECRET=
# Production: GitHub App credentials, supplied by Secret Manager. The app needs
# Contents read/write and Pull requests read/write for PORTFOLIO_REPOSITORY only.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Development-only fallback; use a short-lived GitHub App installation token.
GITHUB_TOKEN=

# Automation
SCHEDULER_SECRET=
